<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Diamond shield frame -->
    <path
        android:pathData="M54,23 L85,44 L73,81 L35,81 L23,44 Z"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="23"
                android:startY="23"
                android:endX="85"
                android:endY="85"
                android:type="linear">
                <item android:color="#FFFF4DA6" android:offset="0.0" />
                <item android:color="#FFFF9900" android:offset="0.5" />
                <item android:color="#FFFFCC00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="23"
                android:startY="23"
                android:endX="85"
                android:endY="85"
                android:type="linear">
                <item android:color="#28FF4DA6" android:offset="0.0" />
                <item android:color="#15FFCC00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Play Triangle -->
    <path
        android:pathData="M48,40 L67,53.5 L48,67 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="48"
                android:startY="40"
                android:endX="67"
                android:endY="67"
                android:type="linear">
                <item android:color="#FFFF55A5" android:offset="0.0" />
                <item android:color="#FFFFCC00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top shine accent / diamond sparkle -->
    <path
        android:pathData="M54,29 L56,34 L61,36 L56,38 L54,43 L52,38 L47,36 L52,34 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
